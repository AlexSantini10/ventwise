FROM python:3.14.2-slim

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /workspace

COPY requirements-dev.txt requirements-ci.txt ./
RUN python -m pip install --upgrade pip \
    && python -m pip install -r requirements-dev.txt -r requirements-ci.txt

ENTRYPOINT ["python", "-m", "pytest", "-p", "no:cacheprovider", "--basetemp=/tmp/pytest"]
CMD ["tests/unit", "tests/integration", "tests/system", "-q"]
